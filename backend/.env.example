# Run API and worker from backend with the SAME environment and SQLite path.
# This file is not loaded automatically:
#   cp .env.example .env
#   set -a; source .env; set +a
# An absolute database path is preferable when running from different directories.
LLMS_DB_PATH=./data/llms.sqlite3
LLMS_CHECK_INTERVAL=86400
LLMS_POLL_INTERVAL=2
LLMS_JOB_TIMEOUT=300
LLMS_MAX_PAGES=40
LLMS_MAX_DEPTH=3
LLMS_REQUEST_TIMEOUT=15
LLMS_REQUEST_DELAY=1
# For a quick local scheduling demo, set LLMS_CHECK_INTERVAL=10.
