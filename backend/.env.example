# Run API and worker from backend with the SAME environment and SQLite path.
# This file is not loaded automatically:
#   cp .env.example .env
#   set -a; source .env; set +a
# An absolute database path is preferable when running from different directories.
LLMS_DB_PATH=./data/llms.sqlite3
LLMS_CHECK_INTERVAL=86400
LLMS_POLL_INTERVAL=2
LLMS_JOB_TIMEOUT=300
LLMS_MAX_PAGES=40
LLMS_MAX_DEPTH=3
LLMS_REQUEST_TIMEOUT=15
LLMS_REQUEST_DELAY=1
# directory: stay under submitted path; site: traverse the entire hostname.
LLMS_CRAWL_SCOPE=directory
# For a quick local scheduling demo, set LLMS_CHECK_INTERVAL=10.

# Separate bounded streaming budgets for sitemap discovery (ordinary pages stay 2 MB).
LLMS_MAX_SITEMAP_BYTES=52428800
LLMS_MAX_SITEMAP_COMPRESSED_BYTES=10485760
LLMS_MAX_SITEMAP_ENTRIES=50000
LLMS_MAX_SITEMAP_TOTAL_BYTES=67108864
LLMS_SITEMAP_TIMEOUT=30
LLMS_MAX_QUERY_VARIANTS=5
